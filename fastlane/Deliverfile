# Cấu hình cho `fastlane deliver` — nộp metadata App Store.
#
#   fastlane deliver --skip_binary_upload --skip_screenshots
#
# Đổi app_identifier và apple_id thành giá trị thật trước khi chạy lần đầu.

app_identifier 'com.example.languageThroughTravel'

# Ngôn ngữ chính của trang App Store. Metadata các locale khác nằm trong
# fastlane/metadata/<locale>/ và được deliver đọc tự động.
primary_category 'EDUCATION'
secondary_category 'TRAVEL'

# Bản nộp không có gì phải kiểm duyệt thủ công: app chạy offline, không tài
# khoản, không mua trong ứng dụng.
submission_information(
  add_id_info_uses_idfa: false,
  export_compliance_uses_encryption: false,
  content_rights_contains_third_party_content: false
)

# An toàn khi chạy trong CI: không mở trình duyệt, không hỏi gì giữa chừng.
force true
overwrite_screenshots true
run_precheck_before_submit false
